#!/bin/sh
# 首次开机自动配置（执行成功后系统会删除本脚本）
# 文件名以 zzzz- 开头，保证排在 Vantage 自带的 30_luci-theme-vantage 之后

LAN_IP="192.168.100.1"

# 1) LAN 管理地址：config_generate 用 add_list 写 ipaddr，必须先删再写
uci -q delete network.lan.ipaddr
uci -q add_list network.lan.ipaddr="${LAN_IP}/24"
uci -q set network.lan.netmask='255.255.255.0'
uci commit network

# 2) 界面强制简体中文（中文语言包已编进固件）
uci -q set luci.main.lang='zh_cn'
uci -q set luci.languages.zh_cn='中文 (Chinese)'
uci commit luci

# 3) 默认主题设为 Vantage
uci -q set luci.main.mediaurlbase='/luci-static/vantage'
uci commit luci

# 4) 清 LuCI 缓存，让菜单与翻译立即生效
rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/

# 5) 清掉系统标识文件里残留的 git hash
#    VERSIONOPT 只覆盖 %V / %C，模板里的 %R 仍是 REVISION（r0-<hash>）。
#    这些文件在 squashfs 上，写入会落到 overlay，属正常做法。
VER_CODE="r1"
[ -f /usr/lib/os-release ] && \
    sed -i "s/^BUILD_ID=.*/BUILD_ID=\"${VER_CODE}\"/" /usr/lib/os-release
[ -f /etc/openwrt_release ] && \
    sed -i "s/^DISTRIB_REVISION=.*/DISTRIB_REVISION='${VER_CODE}'/" /etc/openwrt_release
[ -f /etc/build.version ] && printf '%s\n' "$VER_CODE" > /etc/build.version

# 6) 覆盖 LuCI 版本模块，去掉 "LuCI Master (git-…)" 里的 hash
#    不在编译期用 files/ overlay 覆盖，避免影响 base-files 安装脚本。
mkdir -p /usr/share/ucode/luci
printf "%s\n" "export const revision = 'release', branch = 'LuCI';" \
    > /usr/share/ucode/luci/version.uc
rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/

exit 0
