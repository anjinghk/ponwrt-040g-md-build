# ==============================================================
# 追加到 ponwrt/.config（在 cp configs/an7581.config .config 之后）
# 设备：Nokia XG-040G-MD（AN7581），profile = nokia_xg-040g-md-ubi
# ==============================================================

# ---------- 管理地址 192.168.100.1 ----------
CONFIG_TARGET_PREINIT_IP="192.168.100.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.100.255"

# ---------- 主题（1 个）----------
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y

# ---------- 应用（去重后 6 个）----------
# luci-app-package-manager 原列表写了 2 次 -> 已去重，且官方 config 默认已带
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ttyd=y
# 修正笔误：luci-app-natmapt -> luci-app-natmap（前者不存在）
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-app-airoha-npu=y

# ---------- 补齐的运行期依赖 ----------
# 说明：make defconfig 会按 LUCI_DEPENDS 自动选中它们，这里显式列出便于核对
# 注意：.config 不支持行尾注释，注释一律单独成行
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
# luci-app-upnp 的本体
CONFIG_PACKAGE_miniupnpd=y
# luci-app-ttyd 的本体
CONFIG_PACKAGE_ttyd=y
# luci-app-natmap 的本体
CONFIG_PACKAGE_natmap=y
# luci-app-airoha-npu 的桥接加速模块
CONFIG_PACKAGE_kmod-br-netfilter=y
# luci-app-airoha-npu 读 NPU 寄存器需要 /dev/mem
CONFIG_KERNEL_DEVMEM=y
# luci-app-airoha-npu 需要 busybox devmem applet
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# luci-app-autoreboot 定时重启依赖 crond
CONFIG_BUSYBOX_CONFIG_CROND=y

# ---------- 简体中文（全部插件）----------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
