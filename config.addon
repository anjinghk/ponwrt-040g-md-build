# ==============================================================
# 追加到 ponwrt/.config（在 cp configs/an7581.config .config 之后）
# 设备：Nokia XG-040G-MD（AN7581），profile = nokia_xg-040g-md-ubi
# ==============================================================

# ---------- 管理地址 192.168.100.1 ----------
CONFIG_TARGET_PREINIT_IP="192.168.100.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.100.255"

# ---------- 主题（1 个）----------
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y

# ---------- 应用（8 个；package-manager 上游已内置，此处不重复选中）----------
# 固件里 8 个应用：luci-app-package-manager 由官方 config 默认启用
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 网络唤醒（官方源，依赖 etherwake）
CONFIG_PACKAGE_luci-app-wol=y
# 组播代理（ponwrt 主线自带，IGMPv3/MLDv2）：用于 IPTV 组播，自带 LuCI 界面
CONFIG_PACKAGE_luci-app-omcproxy=y
# iStore 应用商店：源码由 build.sh 从 kenzok8/small-package 拷进本地 package/
CONFIG_PACKAGE_luci-app-store=y
# iStore 依赖（本体 / 任务服务 / 终端库）；defconfig 也会按 LUCI_DEPENDS 自动解析
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
# iStore 是 Lua 应用，ImmortalWrt master 上需 luci-compat 兼容层
CONFIG_PACKAGE_luci-compat=y

# ---------- 补齐的运行期依赖 ----------
# 说明：make defconfig 会按 LUCI_DEPENDS 自动选中它们。
# luci-base / rpcd-mod-ucode 上游 config 已默认选中，不再重复写。
# 注意：.config 不支持行尾注释，注释一律单独成行
# luci-app-upnp 的本体（真实包是 miniupnpd-nftables，miniupnpd 只是 PROVIDES 虚拟名）
CONFIG_PACKAGE_miniupnpd-nftables=y
# luci-app-omcproxy 的本体（IGMPv3/MLDv2 组播代理）
CONFIG_PACKAGE_omcproxy=y
# iStore 装插件时下载用（PonWrt defconfig 默认 is not set，这里显式打开）
CONFIG_PACKAGE_curl=y
# luci-app-ttyd 的本体
CONFIG_PACKAGE_ttyd=y
# luci-app-wol 的本体（发送魔术包）
CONFIG_PACKAGE_etherwake=y
# luci-app-airoha-npu 的桥接加速模块
CONFIG_PACKAGE_kmod-br-netfilter=y
# luci-app-airoha-npu 读 NPU 寄存器需要 /dev/mem
CONFIG_KERNEL_DEVMEM=y
# luci-app-airoha-npu 需要 busybox devmem applet
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# luci-app-autoreboot 定时重启依赖 crond
CONFIG_BUSYBOX_CONFIG_CROND=y

# ---------- 性能优化（AN7581/内核 6.18 通用优化）----------
# BBR 拥塞控制：配合 sysctl tcp_congestion_control=bbr，改善高延迟链路吞吐
CONFIG_PACKAGE_kmod-tcp-bbr=y
# FullCone NAT 由内核补丁 982-985（Broadcom masquerade fullcone）提供，已编进内核。
# 不再使用独立 kmod-nft-fullcone 包（其 2023 源码在 6.18 内核上编译失败）。
# 开机时由 zzzz-custom 设置 firewall defaults.fullcone=2 启用。
# 编译器缓存：重编时命中缓存，编译时间从 1.5~3 小时降到 20~40 分钟
CONFIG_CCACHE=y

# ---------- 简体中文（全部插件）----------
# base / firewall / package-manager / pon 这 4 个中文包上游已默认选中，不再重复写
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-omcproxy-zh-cn=y

# ---------- 自定义固件版本号（去掉 SNAPSHOT 与 git hash）----------
# 打开 VERSIONOPT 后，Kconfig 里 VERSION_DIST 的默认值是 ImmortalWrt，
# 必须显式写回 PonWrt，否则 os-release 与固件文件名都会变成 immortalwrt- 开头
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="PonWrt"
# 版本号与代号：这两行是"本地直接编译时"的默认值。
# GitHub Actions 云编译时会被 build.sh 用当次日期与递增序号自动覆盖
# （主版本=日期如 2026.11.19，代号=r${{ github.run_number }}），无需手改。
CONFIG_VERSION_NUMBER="2026.11"
CONFIG_VERSION_CODE="r1"
# 让固件文件名自动带上版本号与代号，无需手动维护 EXTRA_IMAGE_NAME
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_HOME_URL="https://github.com/anjinghk/ponwrt-040g-md-build"
CONFIG_VERSION_MANUFACTURER="PonWrt"
CONFIG_VERSION_PRODUCT="XG-040G-MD"
CONFIG_VERSION_HWREV="v1"
# 注：apk 源的白名单过滤由 build.sh 自动处理（非标准 feed 自动 FEED_*=n），
#     这里不再硬编码，避免以后加插件时两处维护。
